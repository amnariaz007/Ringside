# Copy to .env (never commit .env). Everything works with these defaults.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# DATABASE_URL=postgres://user:pass@host:5432/payguard   # unset = local SQLite

# mock = no PayPal account needed; sandbox = real calls to api-m.sandbox.paypal.com
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# template = no AI key needed. Planned: gemini | groq | claude
AI_PROVIDER=template

PII_HASH_SALT=change-me
