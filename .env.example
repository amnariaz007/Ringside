# Copy to .env (never commit .env). Everything works with these defaults.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# DATABASE_URL=postgres://user:pass@host:5432/payguard   # unset = local SQLite

# mock = no PayPal account needed; sandbox = real calls to api-m.sandbox.paypal.com
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# template = no AI key needed. gemini = Google Gemini (free tier works); falls back to
# the template on any error, rate limit or failed safety check.
AI_PROVIDER=template
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# Dispute copilot runner: inline now; render_workflow once deployed.
COPILOT_RUNNER=inline

PII_HASH_SALT=change-me

# Demo seller login for judges. Create it with: python manage.py ensure_demo_user
DEMO_USERNAME=demo@juniperlane.example
DEMO_PASSWORD=   # at least 12 characters; never commit the real one

# Comma-separated origins allowed to POST (production), e.g. https://ringside.example.com
CSRF_TRUSTED_ORIGINS=
